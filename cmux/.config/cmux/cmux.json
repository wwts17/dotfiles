{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // 此处设置优先于界面设置；删除键后恢复使用界面设置。

  "app": {
    // 保留 Dock 图标，避免台前调度窗口异常。
    "menuBarOnly": false,
    "preferredEditor": "nvim",
    "sendAnonymousTelemetry": false
  },

  "terminal": {
    // 与 ~/.config/ghostty/config 的 copy-on-select 保持一致
    "copyOnSelect": true,

    // 切回终端有延迟时，可增大 idleSeconds。
    "agentHibernation": {
      "enabled": true,
      "maxLiveTerminals": 12,
      "idleSeconds": 5
    }
  }
}
